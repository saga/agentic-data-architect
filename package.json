{
  "name": "agentic-data-architect",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "description": "Evidence-backed Data Architecture Workbench. See docs/architecture_0930.md",
  "scripts": {
    "start": "tsx src/server-main.ts",
    "dev": "tsx src/server-main.ts",
    "init": "tsx src/cli.ts init",
    "discover": "tsx src/cli.ts discover",
    "ask": "tsx src/cli.ts ask",
    "report": "tsx src/cli.ts report",
    "modernize": "tsx src/cli.ts modernize",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "npm run flow:lint && npm run test:python && tsx --test \"tests/**/*.test.ts\"",
    "build": "vite build && tsc",
    "test:python": "npm run python:check",
    "flow:lint": "tsx src/workflow/lint.ts",
    "gate:modernization": "tsx scripts/legacy-modernization-gate.ts",
    "gate:scope": "tsx scripts/investigation-scope-gate.ts",
    "gate:report": "tsx scripts/investigation-report-gate.ts",
    "python:sync": "uv sync",
    "python:lock": "uv lock",
    "python:check": "uv run python scripts/check-python-deps.py",
    "gate:stage": "tsx scripts/investigation-stage-gate.ts",
    "gate:mission": "tsx scripts/investigation-mission-gate.ts",
    "predev": "node scripts/ensure-opencode.mjs",
    "prestart": "node scripts/ensure-opencode.mjs"
  },
  "dependencies": {
    "@ant-design/x": "^2.9.0",
    "@ant-design/x-markdown": "^2.9.0",
    "@antv/x6": "^3.1.8",
    "@antv/x6-react-shape": "^3.0.1",
    "@duckdb/node-api": "^1.5.6-r.1",
    "@github/copilot-sdk": "^1.0.16",
    "antd": "^6.6.5",
    "antd-img-crop": "^4.30.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "snowflake-sdk": "^3.4.0",
    "undici": "^8.11.2",
    "vite": "^8.3.1",
    "zod": "^4.6.5",
    "@tencent-ai/agent-sdk": "^0.3.267"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}

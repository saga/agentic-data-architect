# Agentic Data Architect 本地运行配置
#
# GitHub Copilot
GITHUB_TOKEN=
COPILOT_MODEL=auto

# 本机 OpenCode
# 运行：opencode serve
OPENCODE_ENABLED=true
OPENCODE_BASE_URL=http://127.0.0.1:4096
# OpenCode Server 使用 OPENCODE_SERVER_PASSWORD 时填写
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=

# 其它项目配置请参考 src/config.ts 中的环境变量 Schema。

# Agentic Data Architect 本地运行配置
#
# GitHub Copilot
GITHUB_TOKEN=
COPILOT_MODEL=claude-sonnet-5.5
# 高频、简单、结构化判断（例如 jevSmartFunc）使用轻量模型。
COPILOT_SIMPLE_MODEL=claude-haiku-5.5

# Agent Runtime：新 Investigation 默认使用 Copilot；quota 不足时按此顺序自动 fallback。
AGENT_RUNTIME_DEFAULT=copilot-sdk
AGENT_RUNTIME_FALLBACK_ORDER=copilot-sdk,codebuddy-sdk,opencode-run

# CodeBuddy Agent SDK 模型过滤；顺序也是 CodeBuddy 模型的 fallback 顺序。
CODEBUDDY_MODEL_ALLOWLIST=glm-5.3-flash,deepseek-v4.1-flash,space-bunny
CODEBUDDY_DEFAULT_MODEL=glm-5.3-flash
# 单次 CodeBuddy Agent query 内允许的模型/工具循环轮数，默认 200。
CODEBUDDY_MAX_TURNS=200
# CodeBuddy SDK 认证：已有 `codebuddy login` 时可不设置 API key。
# 中国版 API Key 需要同时设置 CODEBUDDY_INTERNET_ENVIRONMENT=internal。
# CODEBUDDY_API_KEY=
# CODEBUDDY_INTERNET_ENVIRONMENT=internal
# 可选：如果 SDK 找不到本机 CodeBuddy CLI，可显式指定。
# CODEBUDDY_CODE_PATH=

# 本机 OpenCode
# Agent 模型执行统一走：opencode run
# opencode serve 仅用于模型发现等辅助能力；服务启动脚本仍可自动拉起。
OPENCODE_ENABLED=true
OPENCODE_BASE_URL=http://127.0.0.1:4096
# OpenCode 本机服务默认无需认证；若你自己启用了 OPENCODE_SERVER_PASSWORD，再在这里同步配置
OPENCODE_SERVER_USERNAME=opencode

# 其它项目配置请参考 src/config.ts 中的环境变量 Schema。

# OpenCode 模型白名单（逗号分隔，大小写不敏感子串匹配 id 或显示名）。
# 为空 = 下拉框列出全部；填了就只列命中的。改完重启服务生效。
OPENCODE_MODEL_ALLOWLIST=opencode:opencode/muse-spark-1.3-contributor-free
# 本机 opencode serve 的 Basic 认证密码（用户名固定 opencode）。
# 两边必须一致：启动 serve 时 export OPENCODE_SERVER_PASSWORD=<同样值>。
OPENCODE_SERVER_PASSWORD=dev-local-only

# Web 工作台默认只监听本机；若确实需要局域网/远程访问，必须显式打开。
HOST=127.0.0.1
ALLOW_REMOTE_HOST=false
